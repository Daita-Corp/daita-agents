    "migrations": [
      {
        "affected_paths": [
          "state.db",
          "config.json"
        ],
        "checksum": "a08bdc56e3cb7c3dbe77dc0d8b8ed9aac1299a6a701902dba8e11a5ebe70f25e",
        "definition": "First production agent-home format. Replaces the mutable SQLite-only development ledger with the sole home revision ledger, canonicalizes model configuration, removes redundant record codec discriminators, and admits the three complete preproduction schemas observed before freeze.",
        "migration_id": "agent_home_revision_1",
        "revision": 1
      },
      {
        "affected_paths": [
          "state.db"
        ],
        "checksum": "cb98e978fcb6db71cc1cb3ee5532d92ce99117db7359a008a98a4651df1c20e2",
        "definition": "Atomically replace revision-1 single-job and autonomous-follow-up state with the ratified durable adaptive task graph, preserving terminal evidence and converting only provably safe queued profiles to runnable graph work.",
        "migration_id": "0002_durable_adaptive_task_graph",
        "revision": 2
      },
      {
        "affected_paths": [
          "state.db"
        ],
        "checksum": "3357ee7ad8153e5160d06133082be89dca1e868f1529029f5b63988fae5dca42",
        "definition": "Add caller provenance, opaque personal MCP connection claims and SDK protocol facts and exact external schema contracts while preserving released revision-2 identities, grants, receipts and data. Register retained artifacts with independent ownership and lifecycle state. Convert the exact previously pushed pre-registry development format without rewriting caller or MCP records.",
        "migration_id": "0003_framework_caller_authority",
        "revision": 3
      },
      {
        "affected_paths": [
          "state.db"
        ],
        "checksum": "a1b159370b43f1c9859f477e95cab29d1b7ea3bc1c91ee7945a4e98429a3535b",
        "definition": "Add bounded run-owned child, cell and native cleanup evidence; historical records never authorize computation. Native allocation retains an inherited exclusive closure guard and authenticated launch phases. Durable allocations retain named proof; standalone guards are anonymous. Generation reservations retain capacity for once-only measured or proved non-spawn recovery facts and proof disposal. Recovery appends exact-identity CAS facts without replacing original observations or terminal runs. Add an empty agent-owned declared catalog link table; link currency is computed, never stored. Catalog syncs record whether a bounded discovery was truncated; every historical sync was complete. Retire inactive learning candidates and their review stamps; approved knowledge is unaffected. Routines keep their title, prompt, schedule, named sources, counters and state; their frozen access, grants, routes, sensitivity, budgets, expiry, outcome, precheck, skills and provenance are dropped, and their runs ask before writes. Occurrences drop prechecks and reservations. The task graph is replaced by one checklist-job record per job: finished jobs keep their accepted result, unfinished jobs fail with an upgrade message, result deliveries and receipts keep their job id, graph attention notices are dropped, and the graph tables go.",
        "migration_id": "0004_foreground_analysis_evidence",
        "revision": 4
      }
    ],
