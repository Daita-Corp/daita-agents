/* Layout belongs to Daita; colors and window opacity belong to the terminal. */

/* Cover native widget surfaces without adding a second background palette. */
.modal-panel,
.control-panel,
CompletionPopup,
Button,
Button.-primary,
Button.-success,
Button.-warning,
Button.-error,
Input,
Select,
SelectCurrent,
SelectOverlay,
OptionList,
Tree,
DataTable,
Footer,
FooterKey,
Collapsible,
CollapsibleTitle,
Contents,
MarkdownFence {
    color: $foreground;
    background: $background;
}

Button:hover,
Button:focus {
    text-style: bold reverse;
}

#main-tabs:focus Tab.-active {
    text-style: bold underline reverse;
}

TextArea > .text-area--selection {
    color: $foreground;
    background: $background;
    text-style: reverse;
}

Screen > .screen--selection {
    color: $foreground;
    background: $background;
    text-style: reverse;
}

MarkdownBlock > .code_inline {
    color: $foreground;
    background: $background;
    text-style: bold;
}

Screen {
    color: $foreground;
    background: $background;
}

#boot {
    width: 1fr;
    height: 1fr;
    margin: 1 2;
    padding: 1 2;
    content-align: center middle;
    border: round $border;
}

#chat {
    padding: 0 1;
}

#status-bar {
    height: 1;
    margin: 0 0 1 0;
}

#status-primary {
    width: 1fr;
    min-width: 12;
    height: 1;
    padding-left: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#host-status {
    width: auto;
    height: 1;
    padding: 0 1;
}

#context-window {
    width: auto;
    height: 1;
    min-width: 11;
    padding: 0 1;
    text-align: right;
}

#main-tabs {
    width: auto;
    max-width: 65%;
    height: 1;
    margin-left: 1;
}

#main-tabs Tab {
    color: $text-muted;
    padding: 0 1;
}

#main-tabs Tab.-active {
    color: $primary;
    text-style: bold underline;
}

#main-tabs Underline {
    display: none;
}

#main-view,
#conversation-pane,
#command-sections {
    width: 1fr;
    height: 1fr;
    min-height: 1;
}

#chat-bottom {
    height: auto;
}

.command-section {
    padding: 0 1;
}

.section-action {
    width: 1fr;
    min-width: 0;
    height: 3;
    padding: 0 1;
    border: none;
    color: $foreground;
    text-style: bold;
    content-align: left middle;
    text-align: left;
}

.section-action:hover,
.section-action:focus {
    text-style: bold reverse;
}

.section-description {
    height: auto;
    padding: 0 1 1 1;
    color: $text-muted;
}

#pg-fields {
    height: 1;
    margin-bottom: 1;
}

.section-body {
    height: 1fr;
    min-height: 1;
}

.section-detail {
    display: none;
    width: 1fr;
    height: auto;
    padding: 0 2;
    border-left: solid $border;
}

#command-sections.-wide .section-detail {
    display: block;
}

ProjectionList {
    height: 1fr;
    min-height: 1;
    padding: 0 1;
    border: none;
    color: $foreground;
    scrollbar-size-vertical: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ProjectionList > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

#work-actions {
    height: 3;
}

#work-board {
    layout: horizontal;
    height: 1fr;
    min-height: 4;
}

#work-board.-narrow {
    layout: grid;
    grid-size: 2 2;
}

.work-column {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

.work-column-header {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

.work-column-header.-attention {
    color: $warning;
}

.work-cards {
    height: 1fr;
    min-height: 1;
    padding: 0;
    border: none;
    color: $foreground;
    scrollbar-size-vertical: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.work-cards > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

ChatScreen.-narrow #context-window {
    display: none;
}

ChatScreen.-narrow #main-tabs Tab {
    padding: 0 1;
}

#welcome-region {
    width: 1fr;
    height: 1fr;
    align: center middle;
}

#welcome {
    width: 1fr;
    height: auto;
    padding: 1;
    content-align: center middle;
    color: $text-muted;
}

#suggestions-row {
    height: auto;
}

#suggestions {
    width: 64;
    max-width: 100%;
    height: auto;
    max-height: 4;
    border: none;
    padding: 0 1;
}

#suggestions > .option-list--option-highlighted {
    text-style: none;
}

#suggestions:focus > .option-list--option-highlighted,
#suggestions > .option-list--option-hover {
    text-style: bold reverse;
}

#next-steps {
    height: 1;
    margin: 0 0 1 1;
}

#next-steps-label {
    width: auto;
    padding-right: 2;
    color: $text-muted;
}

#next-steps Button {
    width: auto;
    min-width: 0;
    margin-right: 2;
    color: $foreground;
    text-style: bold;
}

#next-steps Button:hover,
#next-steps Button:focus {
    text-style: bold reverse;
}

#activity-bar {
    height: auto;
    max-height: 6;
    padding: 0 1;
    color: $text-muted;
    border-left: solid $primary;
}

#notice-bar {
    height: auto;
    max-height: 8;
    padding: 0 1;
    color: $warning;
    border-left: solid $warning;
}

#composer {
    height: auto;
    min-height: 3;
    max-height: 8;
    margin-bottom: 1;
    padding: 0 1;
    color: $foreground;
    border: round $border;
}

#composer:focus {
    border: heavy $border;
}

#transcript {
    height: 1fr;
    padding: 0 1;
}

/* The user's turns carry the accent bar; answers sit flush beside them. */
.transcript-user {
    color: $foreground;
    text-style: bold;
    margin-top: 1;
    padding: 0 0 0 1;
    border-left: outer $primary;
}

.transcript-assistant {
    color: $foreground;
    padding: 1 0 0 2;
}

.transcript-summary {
    color: $text-muted;
    padding: 0 0 0 2;
}

.transcript-notice {
    color: $warning;
    padding: 1 0 0 1;
    border-left: solid $warning;
}

ToolCard,
ToolCard Collapsible,
ToolCard Collapsible Contents,
ToolCard Collapsible Contents Static,
ToolCard DataTable {
    color: $foreground;
}

ToolCard CollapsibleTitle {
    width: 1fr;
    color: $text-muted;
    text-style: none;
}

ToolCard CollapsibleTitle:hover {
    color: $foreground;
    text-style: bold reverse;
}

ToolCard CollapsibleTitle:focus {
    color: $foreground;
    text-style: bold reverse;
}

#completions {
    height: auto;
    max-height: 12;
    border: solid $border;
    display: none;
}

#completion-title {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    border-bottom: solid $border;
    text-style: bold;
}

#completion-list {
    height: auto;
    max-height: 9;
    padding: 0 1;
    border: none;
}

#completion-list > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

ModalScreen {
    align: center middle;
    background: $background;
}

AgentCreateScreen,
ModelSetupScreen,
SourceSetupScreen,
SourceEditScreen,
PermissionsScreen {
    align: center middle;
}

.modal-panel,
#editor-prompt,
#review-cost,
#catalog-browser,
#jobs-manager,
#routines-manager,
#result-manager,
#artifacts-manager,
#mcp-management,
#mcp-setup {
    width: 88%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $background;
    border: solid $border;
}

#help-panel {
    height: 90%;
}

#confirm {
    width: 76%;
    max-width: 88;
}

.control-panel {
    width: 88%;
    max-width: 100;
    height: 88%;
    padding: 1 2;
    border: solid $border;
}

.control-panel.compact-panel {
    height: auto;
    max-height: 90%;
}

.control-panel.source-panel,
SourceEditScreen .control-panel {
    height: 94%;
    padding: 0 2;
}

ModalScreen Input,
.control-panel Input {
    height: 2;
    padding: 0 1;
    color: $foreground;
    border: none;
    border-bottom: solid $border;
}

ModalScreen Input:focus,
.control-panel Input:focus {
    border: none;
    border-bottom: heavy $border;
}

ModalScreen Button,
.control-panel Button {
    min-width: 10;
    color: $text-muted;
    border: solid $border;
    text-style: none;
}

ModalScreen Button:hover,
ModalScreen Button:focus,
.control-panel Button:hover,
.control-panel Button:focus {
    color: $foreground;
    border: solid $border;
    text-style: bold reverse;
}

ModalScreen Button.-active,
.control-panel Button.-active {
    color: $foreground;
    border: solid $border;
    text-style: bold reverse;
}

ModalScreen Button:disabled,
.control-panel Button:disabled {
    color: $text-muted;
    border: solid $border;
    text-style: dim;
}

#confirm-yes {
    color: $error;
}

ModalScreen Footer,
.control-panel Footer {
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

ModalScreen FooterKey > .footer-key--key,
.control-panel FooterKey > .footer-key--key {
    color: $foreground;
}

ModalScreen FooterKey > .footer-key--description,
.control-panel FooterKey > .footer-key--description {
    color: $text-muted;
}

.control-panel Select {
    height: 2;
    color: $foreground;
}

.control-panel Select > SelectCurrent {
    height: 2;
    padding: 0 1;
    border: none;
    border-bottom: solid $border;
}

.control-panel Select:focus > SelectCurrent {
    border: none;
    border-bottom: heavy $border;
}

.control-panel Select > SelectOverlay {
    padding: 0;
    color: $foreground;
    border: solid $border;
}

.control-panel Select > SelectOverlay > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

ModelSetupScreen #model-help {
    height: auto;
    padding-bottom: 1;
    color: $text-muted;
}

#picker-title,
#onboard-title,
#confirm-message,
#catalog-title,
#jobs-title,
#routines-title {
    color: $foreground;
    text-style: bold;
    padding-bottom: 1;
}

#mcp-title {
    color: $foreground;
    text-style: bold;
    padding-bottom: 1;
}

#mcp-management {
    height: 88%;
}

#mcp-setup {
    width: 94%;
    height: 96%;
    max-height: 96%;
}

#mcp-setup #mcp-title,
#mcp-setup #mcp-step {
    padding-bottom: 0;
}

#mcp-connect,
#mcp-review,
#mcp-finished {
    height: 1fr;
}

#mcp-reference-fields {
    height: auto;
}

#mcp-tools {
    height: 1fr;
    min-height: 5;
    border: none;
    padding: 0;
}

#mcp-tools > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

#mcp-inspection-body,
#mcp-auth-help,
#mcp-review-help,
#mcp-credential-status {
    height: auto;
}

#mcp-auth-help,
#mcp-review-help {
    color: $text-muted;
}

#mcp-tool-actions {
    height: 3;
}

#mcp-selection-count {
    width: 1fr;
    height: 3;
    content-align: right middle;
}

#mcp-summary,
#mcp-step {
    height: auto;
    padding-bottom: 1;
    color: $text-muted;
}

#mcp-list {
    height: 1fr;
    padding: 1 0;
    border: none;
    border-top: solid $border;
}

#mcp-endpoint {
    margin-bottom: 1;
}

#mcp-help {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

#mcp-actions,
#mcp-setup-actions {
    height: auto;
    margin-top: 1;
}

#mcp-actions Button,
#mcp-setup-actions Button {
    width: auto;
    min-width: 12;
    margin-right: 1;
}

#mcp-setup-actions {
    margin-top: 0;
}

#mcp-error {
    height: auto;
    color: $error;
}

#picker-options {
    height: 1fr;
    padding: 0;
    border: none;
}

#picker-options > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

#picker-actions {
    height: 3;
    margin-top: 1;
}

#picker-actions Button {
    width: auto;
    margin-right: 1;
}

#picker-tertiary {
    color: $error;
}

#catalog-summary {
    height: auto;
    padding-bottom: 1;
    color: $text-muted;
}

#catalog-notice {
    height: auto;
    padding: 0 1 1 1;
    color: $foreground;
    border-left: solid $border;
}

#catalog-notice.-warning {
    color: $warning;
    border-left: solid $warning;
}

#catalog-browser {
    height: 88%;
}

#catalog-modes {
    height: 3;
    padding-bottom: 1;
}

#catalog-modes Button {
    width: auto;
    min-width: 14;
    margin-right: 1;
}

#catalog-tree {
    height: 1fr;
    padding: 0 1;
    border: none;
    border-top: solid $border;
}

#catalog-tree:focus {
    border: none;
    border-top: solid $border;
}

#catalog-tree > .tree--cursor,
#catalog-tree:focus > .tree--cursor {
    color: $foreground;
    text-style: bold reverse;
}

#catalog-tree > .tree--guides-selected,
#catalog-tree:focus > .tree--guides-selected {
    color: $text-muted;
}

#catalog-graph-view {
    display: none;
    height: 1fr;
    border-top: solid $border;
}

#catalog-graph-tree {
    width: 2fr;
    height: 1fr;
    padding: 0 1;
    border: none;
    border-right: solid $border;
}

#catalog-graph-tree:focus {
    border: none;
    border-right: solid $border;
}

#catalog-graph-tree > .tree--cursor,
#catalog-graph-tree:focus > .tree--cursor {
    color: $foreground;
    text-style: bold reverse;
}

#catalog-graph-tree > .tree--guides-selected,
#catalog-graph-tree:focus > .tree--guides-selected {
    color: $text-muted;
}

#catalog-graph-detail {
    width: 1fr;
    min-width: 28;
    height: 1fr;
    padding: 1 2;
    color: $text-muted;
    overflow-y: auto;
}

#catalog-graph-view.-compact {
    layout: vertical;
}

#catalog-graph-view.-compact #catalog-graph-tree {
    width: 1fr;
    height: 2fr;
    border: none;
    border-bottom: solid $border;
}

#catalog-graph-view.-compact #catalog-graph-detail {
    width: 1fr;
    min-width: 0;
    height: 1fr;
    padding: 1;
}

#catalog-help {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

#source-actions {
    height: auto;
    padding-top: 1;
    grid-gutter: 0 1;
}

#source-actions Button {
    width: 1fr;
    min-width: 12;
}

#catalog-graph-actions {
    display: none;
    height: 3;
    padding-top: 1;
}

#catalog-graph-actions Button {
    width: auto;
    min-width: 14;
    margin-right: 1;
}

#jobs-manager,
#routines-manager,
#result-manager {
    height: 88%;
}

#artifacts-manager {
    height: 90%;
}

#artifacts-summary,
#artifacts-list-heading,
#artifacts-overview,
#artifacts-notice,
#artifacts-error,
#artifacts-help {
    height: auto;
}

#artifacts-summary,
#artifacts-list-heading,
#artifacts-help {
    color: $text-muted;
}

#artifacts-list {
    height: 7;
    min-height: 3;
    padding: 0;
    border: none;
    scrollbar-gutter: stable;
}

#artifacts-list-heading {
    padding-right: 2;
}

#artifacts-list > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

#artifacts-detail-scroll {
    height: 1fr;
    min-height: 3;
    padding: 1 0;
    border-top: solid $border;
}

#artifacts-detail {
    height: auto;
}

#artifacts-overview {
    padding-top: 1;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#artifacts-details {
    height: auto;
    padding: 0;
    margin-top: 1;
    border: none;
}

#artifacts-metadata {
    height: auto;
    color: $text-muted;
}

#artifacts-details > CollapsibleTitle {
    padding: 0;
    color: $text-muted;
}

#artifacts-help {
    padding-top: 1;
}

#artifacts-actions,
#artifacts-navigation {
    height: auto;
}

#artifacts-actions Button,
#artifacts-navigation Button {
    width: auto;
    min-width: 8;
    margin-right: 1;
    color: $foreground;
    border: solid $border;
}

#artifacts-actions Button:hover,
#artifacts-actions Button:focus,
#artifacts-navigation Button:hover,
#artifacts-navigation Button:focus {
    color: $foreground;
    border: solid $primary;
    text-style: bold reverse;
}

#artifacts-actions #artifacts-delete {
    color: $error;
    border: solid $error;
    text-style: bold;
}

#artifacts-actions #artifacts-delete:hover,
#artifacts-actions #artifacts-delete:focus {
    color: $error;
    border: solid $error;
    text-style: bold reverse;
}

#artifacts-actions Button:disabled,
#artifacts-navigation Button:disabled {
    color: $text-muted;
    border: solid $border;
    text-style: dim;
}

#artifacts-actions #artifacts-delete:disabled {
    color: $text-muted;
    border: solid $border;
    text-style: dim;
}

#artifacts-error {
    color: $error;
}

ArtifactsScreen.-compact #artifacts-list {
    height: 2;
    min-height: 2;
}

ArtifactsScreen.-compact #artifacts-detail-scroll {
    padding: 0;
}

ArtifactsScreen.-compact #artifacts-overview {
    padding-top: 0;
}

ArtifactsScreen.-compact #artifacts-help {
    padding-top: 0;
}

#jobs-summary,
#jobs-notice {
    height: auto;
    padding-bottom: 1;
    color: $text-muted;
}

#jobs-notice {
    color: $foreground;
}

#jobs-list {
    height: 9;
    min-height: 4;
    padding: 0;
    border: none;
    border-top: solid $border;
}

#jobs-list > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

#jobs-detail-scroll {
    height: 1fr;
    min-height: 5;
    padding: 1 0;
    border: none;
    border-top: solid $border;
}

#jobs-detail {
    height: auto;
    color: $foreground;
}

#jobs-help {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

#jobs-actions {
    height: auto;
    margin-top: 1;
}

#jobs-actions Button {
    width: auto;
    min-width: 10;
    margin-right: 1;
}

#jobs-answer {
    margin-top: 1;
}

#jobs-error {
    height: auto;
    color: $error;
}

#result-detail-scroll {
    height: 1fr;
    min-height: 5;
    padding: 1 0;
    border: none;
    border-top: solid $border;
}

#result-detail {
    height: auto;
    color: $foreground;
}

#result-help {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

#result-actions {
    height: auto;
    margin-top: 1;
}

#result-actions Button {
    width: auto;
    min-width: 10;
    margin-right: 1;
}

#result-error {
    height: auto;
    color: $error;
}

#onboard-error,
#picker-error,
#editor-prompt-error,
#review-cost-error,
#source-edit-error {
    color: $error;
}

#source-edit-help,
#perm-help {
    height: auto;
    padding-bottom: 1;
    color: $text-muted;
}

#perm-preview {
    height: 1fr;
    padding: 1 0;
    border: none;
    border-top: solid $border;
}

SourceSetupScreen #onboard-error {
    width: 1fr;
    height: 1;
    color: $text-muted;
    text-overflow: ellipsis;
}

SourceSetupScreen #onboard-error.-error {
    color: $error;
}

#approval-inline {
    display: none;
    height: 3fr;
    min-height: 8;
    max-height: 18;
    margin-top: 1;
    padding: 0 1 1 1;
    color: $foreground;
    border-left: solid $warning;
}

#approval-inline-title {
    height: 1;
    color: $warning;
    text-style: bold;
}

#approval-inline-document {
    height: 1fr;
    min-height: 1;
    max-height: 12;
    padding: 0 1;
    color: $foreground;
}

#approval-inline-unreviewable {
    height: auto;
    color: $warning;
}

#approval-inline-actions {
    height: 3;
    margin-top: 1;
}

#approval-inline-actions Button {
    width: auto;
    min-width: 14;
    margin-right: 1;
    border: round $border;
}

#approval-inline-yes {
    color: $primary;
}

#approval-inline-no,
#approval-inline-close {
    color: $warning;
}

#confirm-actions {
    height: 3;
    margin-top: 1;
}

#confirm-actions Button {
    width: auto;
    margin-right: 1;
}

.too-small {
    color: $foreground;
}

#routines-summary {
    height: auto;
    padding-bottom: 1;
    color: $text-muted;
}

#routines-list {
    height: 9;
    min-height: 4;
    padding: 0;
    border: none;
    border-top: solid $border;
}

#routines-list > .option-list--option-highlighted {
    color: $foreground;
    text-style: bold reverse;
}

#routines-detail-scroll {
    height: 1fr;
    min-height: 5;
    padding: 1 0;
    border: none;
    border-top: solid $border;
}

#routines-detail {
    height: auto;
    color: $foreground;
}

#routines-help {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

#routines-actions {
    height: auto;
    margin-top: 1;
}

#routines-actions Button {
    width: auto;
    min-width: 8;
    margin-right: 1;
}

#routines-error {
    display: none;
    height: auto;
    color: $error;
}

#routines-error.-visible {
    display: block;
}

RoutinesScreen.-compact #routines-list {
    height: 3;
    min-height: 3;
}

RoutinesScreen.-compact #routines-detail-scroll {
    min-height: 2;
}

RoutinesScreen.-compact #routines-help,
RoutinesScreen.-compact #routines-refresh,
RoutinesScreen.-compact #routines-close {
    display: none;
}

.permission-actions {
    height: auto;
}
